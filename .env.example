# =====================================================================
# Toi & Moi — variables d'environnement
# Copiez ce fichier en `.env` (jamais commité). Les variables EXPO_PUBLIC_*
# sont lisibles dans l'application : n'y mettez JAMAIS de secret.
# Les autres sont des SECRETS SERVEUR : à définir uniquement dans Supabase
#   supabase secrets set NOM=valeur
# (et dans le webhook / la console du service concerné), jamais dans l'app.
# =====================================================================

# --- Supabase (Project Settings › API) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Secret serveur (fonctions, scripts d'import). Ne jamais l'exposer dans l'app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini API (Google AI Studio › Get API key) : secret serveur ---
GEMINI_API_KEY=
# Ex. gemini-3.5-flash-lite (rapide, texte + images) ou gemini-3.8-flash
GEMINI_MODEL=

# --- Open Food Facts / Open Beauty Facts : identification obligatoire des appels ---
# Format conseillé : NomApp/Version (contact@votredomaine.fr)
OPENFOODFACTS_USER_AGENT=

# --- RappelConso (data.economie.gouv.fr, sans clé) : facultatif ---
# RAPPELCONSO_ENABLED=true
# RAPPELCONSO_DATASET=rappelconso-v2-gtin-espaces

# --- Expo / EAS (expo.dev › projet) ---
EXPO_PUBLIC_EAS_PROJECT_ID=
# Secret serveur : envoi des notifications push (expo.dev › Account settings › Access tokens)
EXPO_ACCESS_TOKEN=

# --- RevenueCat (Project settings › API keys : clés publiques par plateforme) ---
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
# Secret serveur : valeur de l'en-tête Authorization du webhook RevenueCat
REVENUECAT_WEBHOOK_SECRET=

# --- Resend (resend.com › API Keys ; domaine vérifié dans Domains) : secrets serveur ---
RESEND_API_KEY=
# Ex. « Toi & Moi <bonjour@votredomaine.fr> » (domaine vérifié chez Resend)
RESEND_FROM_EMAIL=
