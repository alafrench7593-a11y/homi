# ─── Application mobile (lu par Expo ; préfixe EXPO_PUBLIC_ = visible dans l'app, donc JAMAIS de secret ici) ───
# Laisser vide pour lancer l'app en MODE DÉMO (données locales sur l'appareil, sans serveur).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Clés publiques RevenueCat (Project settings › API keys › clés « Public app-specific »)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Identifiant du projet EAS (eas init) — nécessaire aux notifications push
EAS_PROJECT_ID=

# ─── Fonctions Supabase (secrets serveur : `supabase secrets set NOM=valeur`, jamais dans l'app) ───
# ─ Assistant IA (fonction « assistant ») ─
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-... ASSISTANT_MODEL=claude-sonnet-5-5
#   supabase db push && supabase functions deploy assistant
#   Sans ANTHROPIC_API_KEY : réponses « Mode développement : aucune clé IA configurée » (format structuré conservé).
# ANTHROPIC_API_KEY=            # assistant IA et extraction de documents — secret serveur UNIQUEMENT
# ASSISTANT_MODEL=claude-sonnet-5-5   # facultatif, modèle utilisé par l'assistant (valeur par défaut)
# EXTRACTION_MODEL=claude-sonnet-5-5
# APP_NAME="Toi & Moi"
# REVENUECAT_WEBHOOK_SECRET=    # même valeur que l'en-tête Authorization du webhook RevenueCat
# REVENUECAT_SECRET_API_KEY=    # clé secrète v1/v2 RevenueCat (vérification des achats)
# REVENUECAT_ENTITLEMENT=premium
# EXPO_ACCESS_TOKEN=            # envoi des notifications push via l'API Expo
# OPEN_FACTS_ENABLED=true       # recherche produits Open Food Facts / Open Beauty Facts
# OPEN_FACTS_USER_AGENT="ToiEtMoi/1.0 (contact@exemple.fr)"
